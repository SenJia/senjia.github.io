    <div class="mt-8">
      <a href="https://www.linkedin.com/in/sen-j-24683122/" target="_blank" class="btn btn-outline ml-5">Let's connect!</a>
      <a href="https://scholar.google.ca/citations?user=WOsy1foAAAAJ&hl=en" target="_blank" class="btn btn-outline ml-5">Google Scholar</a>
    </div>
  </div>
  -->
</BaseLayout>
